{
  "expo": {
    "name": "DriveIQ",
    "slug": "driveiq",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "driveiq",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A1628",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ahmadaljandali90.driveiq",
      "buildNumber": "2",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ahmad_aljandali90.driveiq",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A1628"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0A1628"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "DriveIQ uses your location in the background to detect trips automatically and score your driving. Data stays on your device.",
          "locationAlwaysPermission": "DriveIQ uses your location in the background to detect trips automatically.",
          "locationWhenInUsePermission": "DriveIQ uses your location to record and score your trips.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "DriveIQ needs access to your photos to set your profile picture.",
          "cameraPermission": "DriveIQ needs the camera to take your profile picture.",
          "microphonePermission": false
        }
      ],
      "expo-task-manager"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "edf52dc2-fb7e-4746-b85b-aae0eb49dd89"
      }
    }
  }
}
